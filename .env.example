# Copy to .env for running on your own computer. On GitHub Actions these are repo secrets / variables.

# Token of the NEW bot from @BotFather (not the posting bot's token)
BOT_TOKEN=
# Owner Telegram user id - the only person who can use the bot in a private chat (DM)
OWNER_ID=8322550258
# The group where every member may use the bot (send /id in the group to see it, e.g. -1001234567890)
GROUP_CHAT_ID=
# Claude API key (platform.claude.com -> API keys; credits must be added)
ANTHROPIC_API_KEY=
# MongoDB Atlas connection string (same cluster as the posting bot is fine)
MONGO_URL=
# Database name - NOT channel_poster_bot (that one belongs to the posting bot)
MONGO_DB_NAME=post_formatter_bot

# ---- optional ----
# Claude model (claude-opus-5-5 = best; claude-sonnet-5-5 / claude-haiku-5-5 = cheaper)
AI_MODEL=claude-opus-5-5
# low | medium | high  (how much Claude thinks; low is enough for formatting)
AI_EFFORT=low
# drafts are deleted from the database after this many days
DRAFT_TTL_DAYS=7
# stop gracefully after N minutes (0 = never; GitHub Actions sets it automatically)
MAX_RUNTIME_MINUTES=0
LOG_LEVEL=INFO
