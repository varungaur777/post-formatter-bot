# Copy to .env for running on your own computer. On GitHub Actions these are repo secrets / variables.

# Token of the NEW bot from @BotFather (not the posting bot's token)
BOT_TOKEN=
# Owner Telegram user id (can add/remove admins with /adduser /removeuser)
OWNER_ID=7364684102
# Other admins who may use the bot (comma or space separated)
SUBMITTER_IDS=
# OpenAI API key (platform.openai.com -> API keys; billing must be set up)
OPENAI_API_KEY=
# MongoDB Atlas connection string (same cluster as the posting bot is fine)
MONGO_URL=
# Database name - NOT channel_poster_bot (that one belongs to the posting bot)
MONGO_DB_NAME=post_formatter_bot

# ---- optional ----
# Text model for formatting and image model for 🎨 Generate image
OPENAI_TEXT_MODEL=gpt-6.1-terra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# 1024x1024 | 1536x1024 | 1024x1536
OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high (higher = better image, more cost)
OPENAI_IMAGE_QUALITY=medium
# none | low | medium | high  (how long the text model thinks)
OPENAI_REASONING_EFFORT=low
# drafts are deleted from the database after this many days
DRAFT_TTL_DAYS=7
# stop gracefully after N minutes (0 = never; GitHub Actions sets it automatically)
MAX_RUNTIME_MINUTES=0
LOG_LEVEL=INFO
